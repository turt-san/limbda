{
    "compilerOptions": {
        "types": ["node"],
        "target": "esnext",
        "module": "esnext",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "declaration": true,
        "declarationMap": true,
        "outDir": "build",
        "rootDir": "src"
    }
}
